    "dotenv": "^18.0.1",
    "firecrawl": "^4.40.0",
    "gsap": "^3.15.0",
    "i18n-iso-countries": "^7.14.0",
    "inngest": "^4.20.0",
    "lucide-react": "^1.47.0",
    "luxon": "^3.7.2",
    "neatlogs": "^1.1.28",
    "next": "16.3.5",
    "next-logger": "^5.0.2",
    "next-themes": "^0.4.6",
    "openai": "^7.19.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.1",
    "serpapi": "^2.2.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
