    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.20.0"
