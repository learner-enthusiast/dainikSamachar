{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:guardrails": "node --import tsx --test Agents/chat/guardrails.rules.test.ts Agents/chat/guardrails.context.test.ts",
    "test:query-enhancer": "node --import tsx --test Agents/chat/queryEnhancerAgent.test.ts",
    "test:small-determiner": "node --import tsx --test Agents/chat/smallDeterminerAgent.test.ts",
    "test:youtube-transcript": "node --import tsx --test Agents/news/YoutubeTranscriptAgent.test.ts",
    "test:youtube-video": "node --import tsx --test Agents/news/YoutubeVideoAgent.test.ts",
    "test:youtube-research": "node --import tsx --test services/news/youtubeResearch.test.ts",
    "test:story-votes": "node --import tsx --test services/news/storyVoteLogic.test.ts",
    "test:news-generation": "node --import tsx --test services/news/newsGenerationRequest.test.ts services/news/newsSearchPlanning.test.ts services/news/newsRequestProgress.test.ts services/news/newsRequestPollingLogic.test.ts services/news/normalizeArticles.test.ts services/news/newsBriefingStages.test.ts",
    "test:newsletter": "node --import tsx --test services/newsletter/newsletterLifecycle.test.ts",
    "test:billing": "node --import tsx --test services/billing/razorpaySignature.test.ts",
    "judges:commits": "node --import tsx scripts/judgesCommits.ts",
    "api:check": "node --import tsx scripts/checkOpenApi.ts",
    "test:api:unit": "node --import tsx --test lib/api/v1/api.unit.test.ts",
    "test:api": "node --import tsx --experimental-test-module-mocks --test --test-concurrency=1 lib/api/v1/api.unit.test.ts app/api/v1/api.integration.test.mts",
    "test:usage": "node --import tsx --test lib/usage/creditRules.test.ts",
    "test:upstox": "node --import tsx --test clients/upstoxClient.test.ts services/upstox/upstoxServices.test.ts services/upstox/marketDataWebsocket.test.ts",
    "upstox:test": "node --import tsx --import dotenv/config scripts/upstoxTest.ts",
    "instruments:sync": "node --import tsx --import dotenv/config scripts/syncInstruments.ts",
    "news:metros:seed": "node --import tsx --import dotenv/config scripts/seedNewsMetros.ts",
    "system-user:seed": "node --import tsx --import dotenv/config scripts/seedSystemUser.ts",
    "design-md:list": "ls vendor/awesome-design-md/design-md",
    "design-md:use": "node --import tsx scripts/design-md-use.ts",
    "news:funnel": "node --import tsx --import dotenv/config scripts/newsFunnel.ts",
    "trace:stock-research": "node --import tsx scripts/observability/runStockResearch.ts",
    "trace:print": "node --import tsx scripts/observability/printTrace.ts",
    "trace:flow": "node --import tsx scripts/observability/runFlow.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "inngest:dev": "pnpm dlx inngest-cli@latest dev -u http://localhost:3000/api/inngest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
